<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LangKinhHuKhong.Editer</AssemblyName>
    <RootNamespace>LangKinhHuKhong.Editer</RootNamespace>
    <ApplicationTitle>LangKinhHuKhong.Editer</ApplicationTitle>
    <Version>4.1.0</Version>
    <FileVersion>4.1.0.0</FileVersion>
    <AssemblyVersion>4.1.0.0</AssemblyVersion>
    <ApplicationIcon>Assets\software-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>
</Project>
